{
  "name": "glassic",
  "version": "1.0.0",
  "description": "Glassic — Now Playing Desktop Widget (Spotify, YouTube, TikTok, Local)",
  "main": "desktop.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "desktop": "electron desktop.js",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.glassic.desktop",
    "productName": "Glassic",
    "artifactName": "Glassic.exe",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "files": [
      "desktop.js",
      "server.js",
      "package.json",
      "public/**/*",
      "scripts/**/*",
      "src/**/*"
    ],
    "asar": false
  },
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.0.2"
  }
}
